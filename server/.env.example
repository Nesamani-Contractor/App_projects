# Copy to .env and fill in. Never commit the real .env file.

PORT=4000

# Public URL this server is reachable at (used to build celebrity photo URLs
# returned to the app, e.g. https://your-api.example.com). For local dev this
# can stay as http://localhost:4000.
PUBLIC_BASE_URL=http://localhost:4000

# --- Skin & makeup analysis provider ---
# "mock" returns realistic fake data with no external calls - good for
# developing the app UI before you have API credentials.
# "perfectcorp" calls the real Perfect Corp YouCam AI API.
SKIN_MAKEUP_PROVIDER=mock

# From the YouCam AI API console (https://yce.perfectcorp.com/ai-api).
# NOTE: the exact auth handshake (RSA-signed id_token -> access_token) and
# endpoint paths in providers/skinMakeup/perfectCorpProvider.js were written
# from documentation snippets, not a live-verified session (this sandbox
# could not reach docs.perfectcorp.com). Confirm against your console/docs
# before relying on it - see the comment at the top of that file.
PERFECTCORP_CLIENT_ID=
PERFECTCORP_CLIENT_SECRET=
PERFECTCORP_API_BASE=https://yce-api-01.perfectcorp.com

# --- Celebrity look-alike provider ---
# "mock" returns a fake match - good for local development.
# "rekognition" calls AWS Rekognition against a face collection you build
# with `npm run build-celebrity-collection` (see server/README.md).
CELEBRITY_MATCH_PROVIDER=mock

AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
REKOGNITION_COLLECTION_ID=shine-me-celebrities
